// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  /// Fase 0 (06/10/2026): schema "whatsapp" pras tabelas do inbox de WhatsApp,
  /// no mesmo Postgres do Lead Engine (FK direto pra User e Workspace).
  schemas  = ["public", "whatsapp"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Fase 0 (login novo, Better Auth): e-mail confirmado. A coluna antiga
  /// emailVerified (data, do NextAuth) fica como estava.
  authEmailVerified Boolean      @default(false)
  /// Papel na plataforma (não é o papel dentro de um workspace). ADMIN = dono do Lead Engine.
  role              PlatformRole @default(USER)
  twoFactorEnabled  Boolean      @default(false)

  /// Tabelas antigas do NextAuth: ficam intactas nesta fase (voltar atrás = só redeploy).
  accounts         Account[]
  sessions         Session[]
  authSessions     AuthSession[]
  authAccounts     AuthAccount[]
  twoFactors       TwoFactor[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  waSessions       WaSession[]
  waKnowledgeDocs  WaKnowledgeDocument[]

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  instagramAccounts  InstagramAccount[]
  automations        Automation[]
  dmLogs             DmLog[]
  trackedLinks       TrackedLink[]
  linkClicks         LinkClick[]
  webhookEvents      WebhookEvent[]
  operationalEvents  OperationalEvent[]
  apiTokens          ApiToken[]
  contacts           Contact[]
  moderationSettings ModerationSettings[]
  commentModerations CommentModeration[]
  draftReplies       DraftReply[]
  outboundMessages   OutboundMessage[]
  sequences          Sequence[]
  conversationLinks  ConversationLink[]
  flows              Flow[]
  segments           Segment[]
  broadcasts         Broadcast[]
  funnels            Funnel[]
  funnelMedia        FunnelMedia[]
  metaCapi           MetaCapiSettings?
  waSessions         WaSession[]
  waContacts         WaContact[]
  waConversations    WaConversation[]
  waMessages         WaMessage[]
  waLabels           WaLabel[]
  waAiUsage          WaAiUsage[]
  waSendBlocks       WaSendBlock[]
  waAgentProfiles    WaAgentProfile[]
  waAgentRuns        WaAgentRun[]
  waAgentConfigs     WaAgentConfig[]
  waKnowledgeDocs    WaKnowledgeDocument[]
  waKnowledgeChunks  WaKnowledgeChunk[]
  waContactMemories  WaContactMemory[]
  integrationCredentials WorkspaceIntegrationCredential[]
  integrationAudits      WorkspaceIntegrationAudit[]

  @@index([ownerId])
  @@schema("public")
}

/// Every DM seen by the webhook (inbound and our own echoes), so the inbox keeps
/// the full history: the Conversations API only returns the latest 20 messages.
model DirectMessage {
  id          String   @id @default(cuid())
  workspaceId String?
  /// Our connected Instagram account (instagramId).
  accountId   String
  /// The other person in the conversation (IGSID).
  contactId   String
  mid         String   @unique
  fromMe      Boolean
  text        String?
  /// Campaign/button DM: {title, subtitle, buttons:[{title,url}]}.
  template    Json?
  storyReply  Boolean  @default(false)
  /// "reply" (answered one of our stories) | "mention" (mentioned us in theirs).
  storyKind   String?
  /// Our story's id when the person replied to it (a mention carries none).
  storyId     String?
  deleted     Boolean  @default(false)
  sentAt      DateTime
  createdAt   DateTime @default(now())

  media DirectMedia[]

  @@index([accountId, contactId, sentAt])
  @@schema("public")
}

/// Photo, video, audio or file attached to a DM, downloaded when it arrives so
/// it survives Meta's expiring CDN links.
model DirectMedia {
  id          String    @id @default(cuid())
  messageId   String
  position    Int       @default(0)
  type        String
  originalUrl String
  mime        String?
  size        Int?
  data        Bytes?
  /// pending | saved | expired | too_big | error | link
  status      String    @default("pending")
  savedAt     DateTime?
  createdAt   DateTime  @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@schema("public")
}

/// Workspace API key for scripts and the MCP endpoint. Only a SHA-256 hash is
/// stored; the key itself is shown once when created.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  /// First characters of the key, so the settings list can tell keys apart.
  prefix      String
  /// Extra rights beyond read/propose. "drafts:approve" lets this key approve
  /// and send a draft (give it only to deterministic code, never to the AI
  /// that proposes the drafts).
  scopes      String[]  @default([])
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@schema("public")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@schema("public")
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
  @@schema("public")
}

model InstagramAccount {
  id                String                 @id @default(cuid())
  workspaceId       String
  instagramId       String                 @unique
  /// App-scoped id of the account (the `id` of /me). Meta's data deletion and
  /// deauthorize callbacks (signed_request user_id) carry this one, not the
  /// professional account id above. Filled on every connect; null on accounts
  /// connected before 2026-10-06 until they reconnect.
  appScopedId       String?
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean                @default(false)
  /// Hours a human takeover pauses every automation for one person.
  takeoverHours     Int                    @default(24)
  /// ACTIVE: automations run. NEEDS_RECONNECT: Meta rejected the token (code
  /// 190). DISCONNECTED: turned off by a person. Only ACTIVE sends anything;
  /// the other two keep every campaign, contact and message untouched, and
  /// connecting the same account again (OAuth upsert) turns it back on.
  status            InstagramAccountStatus @default(ACTIVE)
  disconnectedAt    DateTime?
  /// User id of who turned the channel off.
  disconnectedBy    String?
  reconnectedAt     DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  /// CDN url: it expires, refreshed on reconnect and on "test connection".
  profilePictureUrl String?
  /// Webhook fields subscribed on the last successful subscribe.
  webhookFields     String[]               @default([])
  /// Last webhook Meta delivered for this account (throttled to ~1/min).
  lastWebhookAt     DateTime?
  connectedAt       DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations        Automation[]
  dmLogs             DmLog[]
  linkClicks         LinkClick[]
  followerSnapshots  FollowerSnapshot[]
  contacts           Contact[]
  moderationSettings ModerationSettings?
  commentModerations CommentModeration[]
  draftReplies       DraftReply[]
  outboundMessages   OutboundMessage[]
  conversationLinks  ConversationLink[]
  flows              Flow[]
  broadcasts         Broadcast[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([appScopedId])
  @@schema("public")
}

/// Pedido de exclusão de dados que a Meta manda (signed_request) quando a
/// pessoa remove o app pelo Instagram ou pede a exclusão (06/10/2026). Tabela
/// de sistema: só o callback da Meta grava (papel le_system) e a página
/// pública de status lê só o status pelo código. Nenhum dado pessoal aqui além
/// do id que a Meta mandou.
model DataDeletionRequest {
  id                 String    @id @default(cuid())
  /// Código que a Meta mostra pra pessoa (e que abre a página de status).
  confirmationCode   String    @unique
  /// user_id do signed_request, do jeito que chegou.
  metaUserId         String
  /// RECEIVED, COMPLETED, NOT_FOUND (nenhuma conta com esse id, nada apagado),
  /// AMBIGUOUS (mais de uma conta bate, nada apagado), FAILED.
  status             String    @default("RECEIVED")
  /// Conta apagada (sem FK: a linha da conta some na exclusão).
  instagramAccountId String?
  workspaceId        String?
  /// Quantas linhas saíram de cada tabela.
  deleted            Json?
  error              String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  @@index([metaUserId])
  @@index([createdAt])
  @@schema("public")
}

enum InstagramAccountStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISCONNECTED

  @@schema("public")
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
  @@schema("public")
}

/// What fires a campaign. COMMENT = comment on a post (the original kind; its
/// dmTriggerEnabled flag also answers the same words by DM). DM = only a DM.
/// STORY_REPLY = a reply to one of our stories (storyId, or any story).
/// STORY_MENTION = someone mentions us in their story (no keyword).
/// LIVE_COMMENT = a comment during any of our lives (private reply only).
/// Automation.dmFormat: card with buttons, or text with the link inside.
enum DmFormat {
  BUTTON
  TEXT

  @@schema("public")
}

enum AutomationTrigger {
  COMMENT
  DM
  STORY_REPLY
  STORY_MENTION
  LIVE_COMMENT

  @@schema("public")
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  trigger                 AutomationTrigger @default(COMMENT)
  /// STORY_REPLY only: the story it answers; null = any story.
  storyId                 String?
  storyUrl                String?
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean           @default(false)
  matchAnyPost            Boolean           @default(false)
  keywords                String[]
  matchAnyWord            Boolean           @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled        Boolean           @default(false)
  dmMessage               String
  /// How the link DM goes out (2026-10-06). BUTTON = card with link buttons
  /// (the old way, default for every campaign that already existed). TEXT =
  /// plain text with the tracked link inside: shows in every Instagram
  /// version and in the Requests folder. New campaigns on the screen start TEXT.
  dmFormat                DmFormat          @default(BUTTON)
  openingDmEnabled        Boolean           @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean           @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean           @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int               @default(0)
  publicReplyEnabled      Boolean           @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[]          @default([])
  isActive                Boolean           @default(true)
  wholeWordMatch          Boolean           @default(true)
  reportShareSlug         String?           @unique
  reportShareEnabled      Boolean           @default(true)
  /// Etapa 5: A/B of the opening DM / final message. Off by default: without
  /// it the worker never looks the variants up and sends the texts above.
  abTestEnabled           Boolean           @default(false)
  /// Key of the variant declared winner (its texts were copied above).
  abWinnerKey             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount  InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  sequence          Sequence?
  conversationLinks ConversationLink[]
  variants          CampaignVariant[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([instagramAccountId, trigger, isActive])
  @@schema("public")
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?
  /// Etapa 5: A/B variant ("A" | "B" | "C") the person got. null = no A/B.
  variantKey        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([workspaceId, dmSentAt])
  @@index([automationId, status])
  @@schema("public")
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
  @@schema("public")
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
  @@schema("public")
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  /// DmLog that delivered the link, when the click URL carried the recipient.
  dmLogId            String?
  /// IGSID of the person who received the link (from the signed ?c= param).
  contactIgUserId    String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([contactIgUserId])
  @@schema("public")
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@schema("public")
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
  @@schema("public")
}

// ─── Comment moderation ──────────────────────────────────────────────────────

/// Per Instagram account: how new comments are screened. Starts in OBSERVE, so
/// nothing is hidden until the owner switches to HIDE.
model ModerationSettings {
  id                 String         @id @default(cuid())
  workspaceId        String
  instagramAccountId String         @unique
  mode               ModerationMode @default(OBSERVE)
  /// Built-in categories turned on: spam_link | scam | politics | offense.
  categories         String[]       @default(["spam_link", "scam", "offense"])
  /// Owner's own words/phrases that always flag a comment.
  blockedTerms       String[]       @default([])
  /// A comment containing any of these is never hidden.
  allowedTerms       String[]       @default([])
  /// Ask Jev (TypeSafe) when the rules find nothing. Needs TYPESAFE_API_KEY.
  useJev             Boolean        @default(false)
  jevMinConfidence   Float          @default(0.8)
  /// Ceiling of automatic hides per hour; above it a match is only recorded
  /// (WOULD_HIDE, matchedRule "teto").
  maxHidesPerHour    Int            @default(30)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@schema("public")
}

/// One decision per flagged (or protected) comment. Clean comments are not
/// stored here; ProcessedComment already records that they were seen.
model CommentModeration {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  commentId          String           @unique
  mediaId            String
  commenterIgId      String
  commenterUsername  String?
  commentText        String
  /// ok | spam_link | scam | politics | offense | blocked_term | jev
  verdict            String
  reason             String?
  matchedRule        String?
  jevConfidence      Float?
  action             ModerationAction
  /// own_account | campaign_keyword | allowed_term
  protectedReason    String?
  mode               ModerationMode
  error              String?
  hiddenAt           DateTime?
  /// "auto" (counts toward maxHidesPerHour) | userId | "mcp".
  hiddenBy           String?
  restoredAt         DateTime?
  /// userId, or "mcp" when restored through the API key.
  restoredBy         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([instagramAccountId, action])
  @@index([commenterIgId])
  @@schema("public")
}

enum ModerationMode {
  OFF
  OBSERVE
  HIDE

  @@schema("public")
}

enum ModerationAction {
  NONE
  WOULD_HIDE
  HIDDEN
  RESTORED
  SKIPPED_PROTECTED
  FAILED

  @@schema("public")
}

// ─── Contacts (CRM) ──────────────────────────────────────────────────────────

/// Everyone who commented, sent a DM or clicked a link, per connected account.
/// Keyed by the person's IGSID, which is the same id in comments and DMs.
model Contact {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// Internal InstagramAccount.id (not the instagramId).
  instagramAccountId  String
  /// The person's IGSID.
  igUserId            String
  username            String?
  name                String?
  /// Meta CDN link from the User Profile API. It expires: screens fall back
  /// to the initial.
  profilePicUrl       String?
  /// Last profile lookup (local sources or the User Profile API).
  profileFetchedAt    DateTime?
  /// ok | denied (no consent / not allowed) | error. null = never tried.
  profileStatus       String?
  profileAttempts     Int       @default(0)
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  /// Last DM from the person (Instagram's 24-hour window starts here). Also
  /// moved by a button tap (postback) and an ig.me link into an existing thread.
  lastInboundAt       DateTime?
  /// Last DM we sent (any origin), for "no reply yet".
  lastOutboundAt      DateTime?
  /// A human is answering this person: no automation, sequence or AI draft.
  /// Active while humanTakeover && (humanTakeoverUntil null or in the future).
  humanTakeover       Boolean   @default(false)
  humanTakeoverUntil  DateTime?
  /// userId | "echo" | "mcp"
  humanTakeoverBy     String?
  /// inbox_send | phone_echo | manual
  humanTakeoverReason String?
  commentsCount       Int       @default(0)
  dmsInCount          Int       @default(0)
  dmsOutCount         Int       @default(0)
  campaignsCount      Int       @default(0)
  clicksCount         Int       @default(0)
  hiddenCommentsCount Int       @default(0)
  notes               String?
  /// Etapa 5: wrote PARAR / SAIR / STOP. Out of every future broadcast
  /// (campaigns and flows still answer, as before).
  broadcastOptOutAt   DateTime?
  /// Last known answer of Meta's is_user_follow_business (null = unknown).
  followsBusiness     Boolean?
  followsCheckedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount    InstagramAccount       @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  tags                ContactTag[]
  events              ContactEvent[]
  draftReplies        DraftReply[]
  sequenceEnrollments SequenceEnrollment[]
  linkOpens           ConversationLinkOpen[]
  flowRuns            FlowRun[]
  broadcastRecipients BroadcastRecipient[]
  funnelVisits        FunnelVisit[]
  funnelLeads         FunnelLead[]

  @@unique([instagramAccountId, igUserId])
  @@index([workspaceId, lastSeenAt])
  @@index([workspaceId, username])
  @@index([workspaceId, lastInboundAt])
  @@index([workspaceId, firstSeenAt])
  @@schema("public")
}

/// A tag as plain text: "comentou:FOTO", "recebeu:<campanha>", "clicou", or a
/// manual one.
model ContactTag {
  id          String   @id @default(cuid())
  contactId   String
  workspaceId String
  name        String
  /// auto | manual
  source      String
  createdAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, name])
  @@index([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@schema("public")
}

/// Timeline of a contact. The unique (contactId, type, refId) makes webhook
/// retries, polling and the backfill idempotent: counters only move when a row
/// is really inserted.
model ContactEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  contactId    String
  /// COMMENT | DM_IN | DM_OUT | CAMPAIGN_SENT | CLICK | TAG_ADDED | TAG_REMOVED | COMMENT_HIDDEN | COMMENT_RESTORED
  /// | POSTBACK_IN | REFERRAL | DRAFT_SENT | TAKEOVER_ON | TAKEOVER_OFF | SEQUENCE_STEP
  type         String
  /// commentId | mid | dmLogId | linkClickId | moderationId | tag name
  refId        String
  automationId String?
  mediaId      String?
  text         String?
  meta         Json?
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, type, refId])
  @@index([contactId, occurredAt])
  @@index([workspaceId, type, occurredAt])
  @@schema("public")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

  @@schema("public")
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@schema("public")
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
  SKIPPED_TAKEOVER

  @@schema("public")
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("public")
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM

  @@schema("public")
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR

  @@schema("public")
}

// ─── Etapa 2: drafts, takeover, sequences, conversation links ───────────────

/// Ledger of every message WE send through the API (campaign, follow-up,
/// sequence, approved draft, inbox, private reply). Written before the POST
/// (mid null) and completed with the message_id Meta returns, so an echo can
/// be told apart from a message typed on the phone.
model OutboundMessage {
  id                 String   @id @default(cuid())
  workspaceId        String
  /// Internal InstagramAccount.id.
  instagramAccountId String
  /// The person (IGSID). For a private reply, the commenter.
  contactIgUserId    String
  mid                String?  @unique
  /// automation | followup | sequence | draft | inbox | private_reply | flow | broadcast
  origin             String
  /// dmLogId | draftId | enrollmentId | userId
  refId              String?
  text               String?
  error              String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, contactIgUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, origin, createdAt])
  @@schema("public")
}

/// A reply proposed for one person (by the AI "vendedor" or by hand). Nothing
/// is sent until a human approves it; approval is recorded with who and how.
model DraftReply {
  id                 String      @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  contactId          String
  text               String
  reason             String?
  /// vendedor | manual
  origin             String
  status             DraftStatus @default(PENDING)
  /// The inbound DM (mid) that motivated it.
  basedOnMid         String?
  createdBy          String?
  editedAt           DateTime?
  approvedBy         String?
  /// session | mcp
  approvedVia        String?
  /// ApiToken.id (or "env") when approved through an API key.
  approvedTokenId    String?
  approvedAt         DateTime?
  sentAt             DateTime?
  sentMid            String?
  error              String?
  /// End of the 24-hour window when the draft was created.
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([contactId, status])
  @@schema("public")
}

enum DraftStatus {
  PENDING
  APPROVED
  SENT
  REJECTED
  EXPIRED
  FAILED

  @@schema("public")
}

/// Messages sent after a campaign delivered its link, only while the person's
/// 24-hour window is open. One sequence per campaign.
model Sequence {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String   @unique
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation  Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([workspaceId])
  @@schema("public")
}

model SequenceStep {
  id           String @id @default(cuid())
  sequenceId   String
  /// 1-based.
  order        Int
  message      String
  /// Wait after the previous step (or after the link, for step 1).
  delayMinutes Int

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@schema("public")
}

model SequenceEnrollment {
  id            String         @id @default(cuid())
  workspaceId   String
  sequenceId    String
  contactId     String
  startedAt     DateTime       @default(now())
  lastStepOrder Int            @default(0)
  /// Enrolled while the window was closed (link sent as a private reply to a
  /// comment): steps wait for the person's first reply, which opens the window.
  waitingReply  Boolean        @default(false)
  status        SequenceStatus @default(ACTIVE)
  stoppedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([contactId, status])
  @@schema("public")
}

enum SequenceStatus {
  ACTIVE
  DONE
  STOPPED_REPLY
  STOPPED_WINDOW
  STOPPED_TAKEOVER
  STOPPED_OFF

  @@schema("public")
}

/// https://ig.me/m/<username>?ref=<code> for a story, the bio or a page.
model ConversationLink {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  /// ^[A-Za-z0-9_=-]{1,64}$ (Meta's ref charset). Unique everywhere so /c/<code>
  /// is never ambiguous.
  code               String   @unique
  /// story | bio | pagina | free text
  origin             String
  /// Campaign fired when someone opens the conversation through this link.
  automationId       String?
  /// Tag added to the contact; default "veio:<origin>".
  tagName            String?
  /// Taps on /c/<code> (ig.me itself reports no click).
  clicks             Int      @default(0)
  /// Conversations opened through the link (webhook referral).
  opens              Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount       @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automation       Automation?            @relation(fields: [automationId], references: [id], onDelete: SetNull)
  openEvents       ConversationLinkOpen[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@schema("public")
}

model ConversationLinkOpen {
  id          String   @id @default(cuid())
  linkId      String
  contactId   String
  /// mid, or "ref:<timestamp>" for a referral into an existing thread.
  eventKey    String
  /// message | postback | referral
  kind        String
  isNewThread Boolean  @default(false)
  occurredAt  DateTime

  link    ConversationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([linkId, eventKey])
  @@index([contactId])
  @@schema("public")
}

// ─── Etapa 3: flows (visual builder) ─────────────────────────────────────────
//
// A NEW, optional layer next to campaigns. Campaigns (Automation) keep running
// exactly as before in lib/queue/dm-worker.ts; a flow only gets an event that
// no active campaign matched. Flows are born off (isActive=false), and only a
// signed-in human publishes or turns one on.

enum FlowRunStatus {
  ACTIVE
  WAITING_DELAY
  WAITING_REPLY
  WAITING_TAP
  DONE
  HANDED_OFF
  STOPPED_WINDOW
  STOPPED_TAKEOVER
  STOPPED_OFF
  STOPPED_LIMIT
  FAILED

  @@schema("public")
}

model Flow {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// Internal InstagramAccount.id.
  instagramAccountId  String
  name                String
  isActive            Boolean   @default(false)
  /// Definition being edited (lib/flows/schema.ts, validated with zod).
  draft               Json
  /// Definition the worker runs (copy of the draft at the last publish).
  published           Json?
  publishedVersion    Int       @default(0)
  publishedAt         DateTime?
  publishedBy         String?
  /// Copy of the PUBLISHED trigger, so the worker lookup is an indexed query.
  triggerType         String?
  triggerPostId       String?
  triggerMatchAnyPost Boolean   @default(false)
  triggerStoryId      String?
  conversationLinkId  String?
  keywords            String[]  @default([])
  matchAnyWord        Boolean   @default(false)
  wholeWordMatch      Boolean   @default(true)
  /// Campaign this flow was copied from ("Abrir como fluxo"). No FK: the
  /// campaign is never touched by a flow.
  sourceAutomationId  String?
  enteredCount        Int       @default(0)
  completedCount      Int       @default(0)
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  runs             FlowRun[]
  links            FlowLink[]

  @@index([instagramAccountId, isActive, triggerType])
  @@index([workspaceId])
  @@index([conversationLinkId])
  @@schema("public")
}

/// One person going through one flow. Unique per (flow, trigger event), and at
/// most one open run per (flow, contact) (partial unique index in SQL).
model FlowRun {
  id               String        @id @default(cuid())
  workspaceId      String
  flowId           String
  flowVersion      Int
  contactId        String
  igUserId         String
  status           FlowRunStatus @default(ACTIVE)
  currentNodeId    String?
  /// comment:<id> | live:<id> | dm:<mid> | mention:<mid> | ref:<eventKey>
  triggerKey       String
  /// The comment, for COMMENT / LIVE_COMMENT (the one private reply).
  triggerCommentId String?
  privateReplyUsed Boolean       @default(false)
  waitingUntil     DateTime?
  stepCount        Int           @default(0)
  stopReason       String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime      @updatedAt

  flow    Flow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  steps   FlowStep[]

  @@unique([flowId, triggerKey])
  @@index([contactId, status])
  @@index([flowId, status, currentNodeId])
  @@index([triggerCommentId])
  @@schema("public")
}

model FlowStep {
  id         String   @id @default(cuid())
  runId      String
  flowId     String
  nodeId     String
  nodeType   String
  /// entered | sent | skipped | yes | no | waiting | tapped | replied | timeout | clicked | tagged | notified
  /// | proposed | done | handed_off | stopped | error | maybe_sent
  outcome    String
  detail     String?
  mid        String?
  occurredAt DateTime @default(now())

  run FlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, occurredAt])
  @@index([flowId, nodeId, outcome])
  @@schema("public")
}

/// Tracked link of a flow's link button (/r/<slug>), separate from campaign
/// TrackedLink so nothing in the campaign tables changes.
model FlowLink {
  id             String   @id @default(cuid())
  workspaceId    String
  flowId         String
  nodeId         String
  buttonId       String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  flow   Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  clicks FlowLinkClick[]

  @@unique([flowId, nodeId, buttonId])
  @@schema("public")
}

model FlowLinkClick {
  id              String   @id @default(cuid())
  flowLinkId      String
  flowId          String
  nodeId          String
  runId           String?
  contactIgUserId String?
  ipHash          String?
  userAgent       String?
  createdAt       DateTime @default(now())

  flowLink FlowLink @relation(fields: [flowLinkId], references: [id], onDelete: Cascade)

  @@index([flowId, nodeId])
  @@index([runId])
  @@index([contactIgUserId])
  @@index([flowId, createdAt])
  @@schema("public")
}

// ─── Etapa 5: escala (A/B, segmentos, disparos) ─────────────────────────────

/// One variant of a campaign's A/B test. null texts = the campaign's own.
/// Declaring a winner copies its texts to the campaign, turns the test off
/// and keeps these rows as history (winnerAt on the winner).
model CampaignVariant {
  id               String    @id @default(cuid())
  workspaceId      String
  automationId     String
  /// "A" | "B" | "C"
  key              String
  /// Percent; the active variants add up to 100.
  weight           Int
  openingDmMessage String?
  dmMessage        String?
  isActive         Boolean   @default(true)
  winnerAt         DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, key])
  @@index([automationId])
  @@schema("public")
}

/// A saved CRM filter (lib/segments/filters.ts). Counted live, never cached
/// as a list: the people in it change every minute.
model Segment {
  id                 String    @id @default(cuid())
  workspaceId        String
  /// Internal InstagramAccount.id; null = every account of the workspace.
  instagramAccountId String?
  name               String
  filters            Json
  createdBy          String?
  /// session | mcp
  createdVia         String    @default("session")
  lastCount          Int?
  lastCountAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([workspaceId])
  @@schema("public")
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  CANCELED
  FAILED

  @@schema("public")
}

/// A message to a segment. Instagram only allows it to people whose 24 h
/// window is open, so the recipients are picked when it STARTS (not when it
/// is created) and re-checked one by one before each send. No message tag.
model Broadcast {
  id                 String          @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  segmentId          String?
  /// Filters used (copied from the segment when it starts).
  filtersSnapshot    Json
  name               String
  text               String
  /// [{id,label,kind:"link",url} | {id,label,kind:"flow",flowId}] (up to 3)
  buttons            Json            @default("[]")
  /// [{key,weight,text}] (A/B, up to 3) or null.
  variants           Json?
  abWinnerKey        String?
  /// Skip people in the middle of a flow or sequence (two robots talking).
  skipBusy           Boolean         @default(true)
  status             BroadcastStatus @default(DRAFT)
  stopReason         String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  canceledAt         DateTime?
  canceledBy         String?
  createdBy          String?
  /// session | mcp
  createdVia         String          @default("session")
  sentBy             String?
  batchSize          Int             @default(20)
  pauseSeconds       Int             @default(60)
  /// Claim of the next batch job (bcbatch_<id>_<seq>).
  batchSeq           Int             @default(0)
  /// When the next batch is due (the sweep re-queues a lost one).
  nextBatchAt        DateTime?
  segmentCount       Int             @default(0)
  eligibleCount      Int             @default(0)
  sentCount          Int             @default(0)
  failedCount        Int             @default(0)
  skippedCount       Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  segment          Segment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients       BroadcastRecipient[]
  links            BroadcastLink[]

  @@index([workspaceId, status, createdAt])
  @@index([status, scheduledAt])
  @@schema("public")
}

enum BroadcastRecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  MAYBE_SENT
  SKIPPED_WINDOW
  SKIPPED_TAKEOVER
  SKIPPED_OPTOUT
  SKIPPED_CHANNEL
  SKIPPED_LIMIT
  SKIPPED_BUSY
  SKIPPED_CANCELED

  @@schema("public")
}

/// One person of a broadcast. The unique (broadcastId, contactId) is the
/// dedupe: nobody gets the same broadcast twice.
model BroadcastRecipient {
  id          String                   @id @default(cuid())
  broadcastId String
  workspaceId String
  contactId   String
  igUserId    String
  variantKey  String?
  status      BroadcastRecipientStatus @default(PENDING)
  mid         String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@index([igUserId])
  @@schema("public")
}

/// Tracked link of a broadcast button (/r/<slug>), resolved after campaign
/// and flow links. Slugs are unique across the three tables.
model BroadcastLink {
  id             String   @id @default(cuid())
  workspaceId    String
  broadcastId    String
  buttonId       String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())

  broadcast Broadcast            @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  clicks    BroadcastLinkClick[]

  @@unique([broadcastId, buttonId])
  @@schema("public")
}

model BroadcastLinkClick {
  id              String   @id @default(cuid())
  broadcastLinkId String
  broadcastId     String
  recipientId     String?
  contactIgUserId String?
  ipHash          String?
  userAgent       String?
  createdAt       DateTime @default(now())

  link BroadcastLink @relation(fields: [broadcastLinkId], references: [id], onDelete: Cascade)

  @@index([broadcastId, createdAt])
  @@index([contactIgUserId])
  @@schema("public")
}

// ─── Etapa 6: funis interativos (Quiz) ───────────────────────────────────────

enum FunnelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("public")
}

/// Etapa 6: funil interativo (quiz). Definição em JSON (lib/funnels/schema.ts).
model Funnel {
  id               String       @id @default(cuid())
  workspaceId      String
  name             String
  /// Global (a URL pública /q/<slug> não tem workspace).
  slug             String       @unique
  status           FunnelStatus @default(DRAFT)
  draft            Json
  /// Cópia congelada do rascunho na última publicação. Público só lê isto.
  published        Json?
  publishedVersion Int          @default(0)
  publishedAt      DateTime?
  publishedBy      String?
  templateId       String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visits    FunnelVisit[]
  events    FunnelEvent[]
  leads     FunnelLead[]
  purchases FunnelPurchase[]
  media     FunnelMedia[]

  @@index([workspaceId, updatedAt])
  @@schema("public")
}

/// Arquivo (foto, GIF, vídeo) enviado pelo editor do quiz pro armazenamento
/// próprio (S3 compatível). A chave nunca leva o nome original do arquivo.
model FunnelMedia {
  id          String    @id @default(cuid())
  workspaceId String
  funnelId    String
  /// <workspaceId>/<funnelId>/<aaaa-mm>/<uuid>.<ext>
  key         String    @unique
  url         String
  /// image | video
  kind        String
  contentType String
  size        Int
  /// Nome original, só pra mostrar na lista (até 120 caracteres).
  name        String?
  createdBy   String?
  /// Preenchido quando o navegador termina o envio. Null = envio não confirmado.
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnel    Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, funnelId, createdAt])
  @@schema("public")
}

model FunnelVisit {
  id              String    @id @default(cuid())
  workspaceId     String
  funnelId        String
  /// 32 hex gerado no navegador. Global (vira xcod no checkout Hotmart).
  visitorId       String
  funnelVersion   Int
  contactId       String?
  /// utm_*, fbclid, gclid, src, sck da entrada.
  tracking        Json?
  /// utm_source em minúsculas ou "direto".
  source          String
  referrerHost    String?
  /// mobile | tablet | desktop
  device          String?
  ipHash          String?
  maxStepIndex    Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  checkoutAt      DateTime?
  leadAt          DateTime?
  purchasedAt     DateTime?
  refundedAt      DateTime?
  /// Consentimento de anúncios (Pixel/CAPI) da visita: true = pode mandar
  /// eventos server-side; false/null = não manda. Calculado no servidor com o
  /// modo do quiz (banner = só depois do "Aceitar"; notice = já vale).
  adConsent       Boolean?
  /// Só gravados com consentimento E com a API de Conversões configurada.
  /// Usados no Purchase da Hotmart (que chega sem o navegador).
  clientIp        String?
  clientUserAgent String?
  /// Cookies _fbp / _fbc do Pixel do navegador.
  fbp             String?
  fbc             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  funnel    Funnel           @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contact   Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events    FunnelEvent[]
  lead      FunnelLead?
  purchases FunnelPurchase[]

  @@unique([funnelId, visitorId])
  @@index([visitorId])
  @@index([funnelId, createdAt])
  @@index([funnelId, source, createdAt])
  @@index([contactId])
  @@schema("public")
}

/// Pixel padrão e API de Conversões da Meta da conta (1 por workspace).
/// O token fica só criptografado (AES-256-GCM, lib/meta/oauth.ts) e nunca sai
/// em nenhuma API: a tela vê só os 4 últimos caracteres.
model MetaCapiSettings {
  id             String   @id @default(cuid())
  workspaceId    String   @unique
  /// Só dígitos (5 a 20). Quiz sem Pixel próprio usa este.
  pixelId        String?
  accessTokenEnc String?
  tokenLast4     String?
  /// Código de evento de teste do Gerenciador de Eventos (opcional).
  testEventCode  String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model FunnelEvent {
  id          String   @id @default(cuid())
  workspaceId String
  funnelId    String
  visitId     String
  /// view | answer | checkout | complete
  type        String
  stepId      String
  /// "" quando não é de um bloco (unique não aceita null repetido).
  blockId     String   @default("")
  /// answer: { optionIds: string[] }
  value       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funnel Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  visit  FunnelVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, type, stepId, blockId])
  @@index([funnelId, type, createdAt])
  @@schema("public")
}

model FunnelLead {
  id          String    @id @default(cuid())
  workspaceId String
  funnelId    String
  visitId     String    @unique
  contactId   String?
  name        String?
  email       String?
  /// Só dígitos com DDI, ex.: 5511999998888.
  phone       String?
  /// name -> rótulos escolhidos
  answers     Json
  tags        String[]  @default([])
  consentAt   DateTime?
  consentText String?
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  funnel  Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  visit   FunnelVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([funnelId, createdAt])
  @@index([workspaceId, email])
  @@schema("public")
}

model FunnelPurchase {
  id             String   @id @default(cuid())
  /// null = compra que não casou com nenhuma visita/lead.
  workspaceId    String?
  funnelId       String?
  visitId        String?
  leadId         String?
  contactId      String?
  provider       String   @default("hotmart")
  transaction    String
  /// PURCHASE_APPROVED, PURCHASE_COMPLETE, PURCHASE_REFUNDED, PURCHASE_CHARGEBACK, PURCHASE_CANCELED...
  event          String
  status         String?
  productId      String?
  productName    String?
  offerCode      String?
  amountCents    Int?
  currency       String?
  /// sha256(sal + e-mail minúsculo). E-mail puro não é guardado aqui.
  buyerEmailHash String?
  src            String?
  sck            String?
  xcod           String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  funnel Funnel?      @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  visit  FunnelVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@unique([provider, transaction, event])
  @@index([funnelId, occurredAt])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Fase 0 (06/10/2026): login novo (Better Auth) e Lead Engine multiusuário.
// Tudo aqui é novo: as tabelas do NextAuth (Account, Session, VerificationToken)
// continuam intactas pra dar pra voltar atrás só com um redeploy.
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  ADMIN

  @@schema("public")
}

/// Sessão do login novo. O cookie guarda só o token.
model AuthSession {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

/// Forma de entrar: providerId "credential" (senha, com hash) ou "google".
/// Link mágico não precisa de linha aqui.
model AuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash da senha (scrypt). Nunca a senha em si.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@schema("public")
}

/// Tokens de uso único: link mágico, desafio do 2FA, troca de e-mail.
model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("public")
}

/// 2FA por app autenticador (TOTP). Segredo e códigos de recuperação criptografados.
model TwoFactor {
  id                      String    @id
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@schema("public")
}

/// Quem pode entrar no beta (além do ALLOWED_EMAILS e dos convites de workspace).
model BetaAllowlist {
  /// Sempre minúsculo.
  email       String   @id
  canWhatsapp Boolean  @default(true)
  addedById   String?
  note        String?
  createdAt   DateTime @default(now())

  @@schema("public")
}

/// Toda vez que o admin abre conteúdo de outro workspace (LGPD). Só cresce:
/// a RLS não deixa ninguém editar nem apagar.
model AdminAccessLog {
  id                String   @id @default(cuid())
  adminUserId       String
  targetWorkspaceId String
  targetUserId      String?
  /// ex.: "whatsapp.conversation"
  resource          String
  resourceId        String?
  reason            String
  createdAt         DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetWorkspaceId, createdAt])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Schema "whatsapp" (fase 0: tabelas vazias, RLS ligada desde o primeiro dia).
// O acesso segue o workspace: quem é membro do workspace vê e responde.
// ---------------------------------------------------------------------------

enum WaProvider {
  OPENWA
  CLOUD_API
  /// uazapi (06/10/2026): não oficial, com proxy gerenciado por cidade (IP do Brasil).
  UAZAPI

  @@schema("whatsapp")
}

enum WaStatus {
  PENDING
  QR_READY
  CONNECTED
  DISCONNECTED
  RESTRICTED
  BANNED

  @@schema("whatsapp")
}

enum WaAgentMode {
  INHERIT
  OFF
  DRAFT
  AUTO

  @@schema("whatsapp")
}

enum WaSentBy {
  CONTACT
  USER_APP
  USER_PHONE
  AGENT

  @@schema("whatsapp")
}

/// Um número de WhatsApp conectado.
model WaSession {
  id                String      @id @default(cuid())
  workspaceId       String
  /// Quem conectou o número.
  ownerUserId       String
  provider          WaProvider  @default(OPENWA)
  /// id no OpenWA, phone_number_id na Meta ou id da instância na uazapi.
  providerSessionId String      @unique
  phoneE164         String?
  displayName       String?
  status            WaStatus    @default(PENDING)
  /// Segredo HMAC do webhook desta sessão, criptografado.
  webhookSecretEnc  String?
  agentMode         WaAgentMode @default(OFF)
  /// Termo de risco do modo experimental (OpenWA).
  riskAcceptedAt    DateTime?
  connectedAt       DateTime?
  lastEventAt       DateTime?
  /// Números que o admin pode ver sem abrir conteúdo.
  conversationCount Int         @default(0)
  messageCount      Int         @default(0)
  /// Cloud API (coexistência): WABA do número. OpenWA não usa.
  wabaId            String?
  /// Cloud API: token de negócio cifrado (AES-256-GCM). OpenWA não usa.
  accessTokenEnc    String?
  /// uazapi: token da instância cifrado (AES-256-GCM, ENCRYPTION_KEY).
  instanceTokenEnc  String?
  /// uazapi: região do proxy gerenciado (valores de /proxy-managed/*).
  proxyCountry      String?
  proxyState        String?
  proxyCity         String?
  proxyCityLabel    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  contacts      WaContact[]
  conversations WaConversation[]
  messages      WaMessage[]
  agentProfile  WaAgentProfile?
  agentConfigs  WaAgentConfig[]

  @@index([workspaceId])
  @@index([ownerUserId])
  @@schema("whatsapp")
}

model WaContact {
  id           String   @id @default(cuid())
  workspaceId  String
  sessionId    String
  /// 5511...@c.us, @lid ou @g.us
  jid          String
  phoneE164    String?
  /// Nome que o usuário salvou.
  name         String?
  /// Nome que a pessoa usa.
  pushName     String?
  avatarUrl    String?
  isGroup      Boolean  @default(false)
  /// Ligação opcional com o Contact do Lead Engine.
  crmContactId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session       WaSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversations WaConversation[]
  memories      WaContactMemory[]

  @@unique([sessionId, jid])
  @@index([workspaceId, name])
  @@schema("whatsapp")
}

model WaConversation {
  id                 String      @id @default(cuid())
  workspaceId        String
  sessionId          String
  contactId          String
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int         @default(0)
  archivedAt         DateTime?
  pinnedAt           DateTime?
  mutedUntil         DateTime?
  agentMode          WaAgentMode @default(INHERIT)
  /// Alguém assumiu: agente pausado até aqui.
  humanTakeoverUntil DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   WaSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact   WaContact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  WaMessage[]
  labels    WaConversationLabel[]
  agentRuns WaAgentRun[]

  @@unique([sessionId, contactId])
  @@index([workspaceId, archivedAt, pinnedAt(sort: Desc), lastMessageAt(sort: Desc)])
  @@index([workspaceId, unreadCount])
  @@schema("whatsapp")
}

model WaMessage {
  id                String    @id @default(cuid())
  workspaceId       String
  sessionId         String
  conversationId    String
  providerMessageId String
  fromMe            Boolean
  sentBy            WaSentBy
  /// text | image | audio | video | document | sticker | location | reaction
  type              String
  body              String?
  quotedId          String?
  /// pending | sent | delivered | read | failed
  ack               String    @default("pending")
  sentAt            DateTime
  editedAt          DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  /// Run do agente que mandou (sentBy = AGENT).
  agentRunId        String?
  /// Mídia: tipo e nome do arquivo. Os bytes ficam no gateway (o inbox busca por /api/whatsapp/media/<id>).
  mediaMime         String?
  mediaFilename     String?
  /// Cloud API: id da mídia na Meta.
  mediaRef          String?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session      WaSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Webhook repetido não duplica.
  @@unique([sessionId, providerMessageId])
  @@index([conversationId, sentAt(sort: Desc)])
  @@index([conversationId, sentBy, sentAt(sort: Desc)])
  @@schema("whatsapp")
}

model WaLabel {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  /// #RRGGBB
  color       String
  position    Int         @default(0)
  agentMode   WaAgentMode @default(INHERIT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations WaConversationLabel[]

  @@unique([workspaceId, name])
  @@schema("whatsapp")
}

model WaConversationLabel {
  conversationId String
  labelId        String
  workspaceId    String
  createdAt      DateTime @default(now())

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        WaLabel        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([workspaceId, labelId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Chaves de IA da plataforma e gasto de IA (06/10/2026, pedido do dono: "as
// API quero colocar a chave no admin" e "relatório de gasto das APIs e de
// clientes"). Só o admin lê e grava as chaves e as configurações (RLS); os
// agentes leem no servidor pelo papel de sistema (lib/ai/credentials.ts).
// ---------------------------------------------------------------------------

/// Uma chave por provedor (anthropic, openai, typesafe), usada por todos os
/// usuários do beta. keyEnc = AES-256-GCM (encryptToken, ENCRYPTION_KEY).
model PlatformAiCredential {
  id          String   @id @default(cuid())
  /// anthropic | openai | typesafe
  provider    String   @unique
  keyEnc      String
  keyLast4    String
  active      Boolean  @default(true)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

/// Linha única (id = "global"): modelo de cada agente, tetos diários, tabela
/// de preços e cotação do dólar. JSON validado em lib/ai/catalog.ts.
model PlatformAiSettings {
  id                   String   @id @default("global")
  agentModels          Json?
  prices               Json?
  dailyCapUserUsd      Float    @default(1)
  dailyCapWorkspaceUsd Float    @default(3)
  /// Cotação pra mostrar em R$ (opcional). null = só dólar.
  usdToBrl             Float?
  updatedById          String?
  updatedAt            DateTime @updatedAt

  @@schema("public")
}

/// Gasto de IA: uma linha por chamada paga (ou bloqueada pelo teto). Mesmos
/// nomes da tabela do branch feat/wa-cerebro, com as colunas extras do
/// relatório. lib/ai/usage.ts grava e lê.
model WaAiUsage {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerUserId    String
  workspaceId    String
  /// embedding | memory | agent | triage
  kind           String
  /// qualificacao | atendimento | suporte | cerebro | triagem
  agent          String?
  provider       String
  model          String
  contactId      String?
  conversationId String?
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  cacheRead      Int       @default(0)
  cacheWrite     Int       @default(0)
  /// 1 = US$ 0,000001
  costMicroUsd   BigInt    @default(0)
  /// true = não chamou o modelo porque passaria do teto diário.
  blocked        Boolean   @default(false)
  refId          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt(sort: Desc)], map: "WaAiUsage_owner_created_idx")
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// WhatsApp, fase 1 (06/10/2026): conector, cérebro e agentes. Migrações
// 20261015120000_wa_conector, 20261015130000_wa_cerebro e
// 20261015140000_wa_agentes. Mesma RLS das tabelas whatsapp.* da Fase 0.
// ---------------------------------------------------------------------------

/// Evento cru do webhook: idempotência (dedupeKey) e reprocessamento. Só o
/// papel de sistema lê e grava. Apagado depois de 30 dias.
model WaWebhookEvent {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId   String?
  ownerUserId String?
  provider    WaProvider
  eventType   String
  dedupeKey   String     @unique
  payload     Json
  /// received | queued
  status      String     @default("received")
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@schema("whatsapp")
}

/// Envio barrado (24h, "Assumir", número desconectado, agente cancelado).
model WaSendBlock {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerUserId    String
  workspaceId    String
  sessionId      String
  conversationId String
  sentBy         WaSentBy
  reason         String
  agentRunId     String?
  preview        String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@schema("whatsapp")
}

/// Perfil do agente por número (1 por WaSession).
model WaAgentProfile {
  id              String    @id @default(cuid())
  workspaceId     String
  ownerUserId     String
  sessionId       String    @unique
  /// Comando base: o que o negócio faz e o que pode prometer.
  baseCommand     String    @default("")
  styleSummary    String?
  styleExamples   Json?
  /// {"start":"21:00","end":"08:00"}
  quietHours      Json?
  maxAutoPerDay   Int       @default(50)
  /// Preços, prazos e links que o agente pode citar.
  fatosPermitidos Json?
  timeZone        String    @default("America/Sao_Paulo")
  /// Atraso humano antes da 1ª bolha (envio automático).
  delayMinSeconds Int       @default(20)
  delayMaxSeconds Int       @default(90)
  learnedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@schema("whatsapp")
}

/// Cada resposta do agente (rascunho, envio, bloqueio, erro), com custo.
model WaAgentRun {
  id             String      @id @default(cuid())
  workspaceId    String
  ownerUserId    String
  sessionId      String
  conversationId String
  triggerMsgId   String
  /// qualificacao | atendimento | suporte
  agente         String?
  mode           WaAgentMode
  /// pending | draft | approved | scheduled | sent | rejected | blocked | error | skipped | handoff
  status         String
  output         Json?
  blockedReason  String?
  provider       String?
  model          String?
  tokensIn       Int         @default(0)
  tokensOut      Int         @default(0)
  cacheRead      Int         @default(0)
  cacheWrite     Int         @default(0)
  /// 1 dólar = 1.000.000. Run "pending" guarda a reserva do pior caso.
  custoUsdMicro  Int         @default(0)
  triagem        Json?
  approvedBy     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([conversationId, status])
  @@schema("whatsapp")
}

/// Os 3 agentes de cada número. Nascem desligados.
model WaAgentConfig {
  id            String   @id @default(cuid())
  workspaceId   String
  ownerUserId   String
  sessionId     String
  /// qualificacao | atendimento | suporte
  agente        String
  ativo         Boolean  @default(false)
  provider      String?
  modelo        String?
  modeloDificil String?
  instrucoes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, agente])
  @@index([workspaceId])
  @@schema("whatsapp")
}

/// PDF do cérebro de um agente. O código usa SQL cru (lib/whatsapp/cerebro/store.ts).
model WaKnowledgeDocument {
  id              String    @id
  ownerUserId     String
  workspaceId     String
  agentKind       String
  sessionId       String?
  fileName        String
  sizeBytes       Int
  sha256          String
  data            Bytes?
  pageCount       Int?
  status          String    @default("queued")
  errorCode       String?
  chunkCount      Int       @default(0)
  embeddingModel  String?
  embeddingTokens Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)

  owner     User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    WaKnowledgeChunk[]

  @@unique([workspaceId, agentKind, sha256], map: "WaKnowledgeDocument_ws_agent_sha_key")
  @@index([workspaceId, agentKind, createdAt(sort: Desc)], map: "WaKnowledgeDocument_ws_agent_idx")
  @@schema("whatsapp")
}

/// Pedaço de PDF com embedding. Com pgvector a coluna é vector(1536); sem ele, real[].
model WaKnowledgeChunk {
  id             String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  documentId     String
  ownerUserId    String
  workspaceId    String
  agentKind      String
  sessionId      String?
  position       Int
  page           Int
  content        String
  tokenEstimate  Int
  embeddingModel String
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)

  document  WaKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([workspaceId, agentKind, embeddingModel], map: "WaKnowledgeChunk_ws_agent_idx")
  @@schema("whatsapp")
}

/// Memória curta por contato (o agente lê antes de responder).
model WaContactMemory {
  contactId   String
  workspaceId String
  ownerUserId String
  nome        String?
  interesse   String?
  objecao     String?
  etapa       String   @default("novo")
  observacao  String?
  version     Int      @default(1)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   WaContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([workspaceId, contactId])
  @@schema("whatsapp")
}

/// Canais > Conexões e chaves (06/10/2026): chave de integração do workspace
/// (uazapi, gateway OpenWA). Um valor por campo, cifrado (ENCRYPTION_KEY).
/// Só last4 sai. Precedência: este valor > variável de ambiente > nada.
/// lib/integrations/credentials.ts lê e grava. RLS: só dono/admin do workspace.
model WorkspaceIntegrationCredential {
  id          String   @id @default(cuid())
  workspaceId String
  /// uazapi | openwa
  service     String
  /// uazapi: serverUrl | adminToken | maxInstances; openwa: baseUrl | apiKey
  field       String
  valueEnc    String
  last4       String
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, service, field])
  @@schema("public")
}

/// Quem salvou, trocou, removeu ou testou uma chave de integração. Nunca o valor.
model WorkspaceIntegrationAudit {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String
  service     String
  field       String?
  /// saved | replaced | removed | tested
  action      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@schema("public")
}
