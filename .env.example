# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Login novo (fase 0, Better Auth). Veja docs/fase0-multiusuario.md.
# Segredo do login: `openssl rand -base64 32`. Sem ele, usa o NEXTAUTH_SECRET.
BETTER_AUTH_SECRET=
# Endereço público do painel (sem barra no fim). Sem ele, usa o NEXTAUTH_URL.
BETTER_AUTH_URL=
# Entrar com o Google (opcional). Sem os dois, o botão do Google não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails de admin da plataforma pro script scripts/migrar-login-better-auth.ts
# (vírgula entre eles). O admin é obrigado a usar 2FA.
ADMIN_EMAILS=
# RLS (fase 0): conexão própria do papel da aplicação (opcional). Sem ela, a
# conexão do DATABASE_URL troca pro papel abaixo em cada transação.
DATABASE_URL_APP=
# Papel que a aplicação assume nas tabelas com RLS (padrão le_app; "off" desliga a troca).
DB_RLS_ROLE=
# Papel dos webhooks, cron e worker antes de saber de quem é o evento (padrão le_system).
DB_SYSTEM_ROLE=

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: API token for scripts and the MCP endpoint (/api/mcp).
# At least 32 characters (e.g. `openssl rand -hex 32`). Unset = token access off.
OPENREPLY_API_TOKEN=
# Optional: which user the token acts as (defaults to the oldest workspace owner).
OPENREPLY_API_USER_EMAIL=

# Etapa 6 (quiz): token "hottok" do webhook da Hotmart (Ferramentas > Webhook).
# Sem ele, /api/webhooks/hotmart responde 503 e nenhuma compra é marcada.
# HOTMART_HOTTOK=

# Etapa 6 (quiz): envio de fotos, GIFs e vídeos pelo editor, direto pro
# armazenamento S3 compatível (path-style: <endpoint>/<bucket>/<chave>), com
# leitura pública do bucket e CORS liberado pra origem do painel.
# Sem as 5 o botão "Enviar arquivo" não aparece (o editor só aceita link).
# MEDIA_PUBLIC_BASE_URL = <endpoint>/<bucket>, sem barra no fim.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=
# Opcional (padrão us-east-1).
# MEDIA_S3_REGION=
